{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agcn.local/schema/presenter-example-v1.json",
  "title": "AGCN Presenter Training Example v1",
  "type": "object",
  "required": [
    "id",
    "version",
    "input",
    "target",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": "1.0"
    },
    "input": {
      "type": "object",
      "required": [
        "mode",
        "product",
        "live_conditions",
        "recent_comments",
        "recent_speeches",
        "recent_facts",
        "sales_thread",
        "planner_topic",
        "allowed_facts"
      ],
      "properties": {
        "mode": {
          "enum": [
            "proactive",
            "comment_reply"
          ]
        },
        "product": {
          "type": "object"
        },
        "live_conditions": {
          "type": "object"
        },
        "commercial_rules": {
          "type": "object",
          "properties": {
            "live_inventory_limited": {
              "type": "boolean"
            },
            "generic_scarcity_enabled": {
              "type": "boolean"
            },
            "stock_quantity": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "stock_quantity_label": {
              "type": [
                "string",
                "null"
              ]
            },
            "stock_exhausted": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "comment": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "id",
                "username",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "username": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "decision": {
          "type": "object"
        },
        "recent_comments": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "recent_speeches": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recent_facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sales_thread": {
          "type": "string"
        },
        "planner_topic": {
          "type": "string"
        },
        "allowed_facts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "required": [
        "speech",
        "topic",
        "used_facts",
        "needs_fact",
        "next_sales_thread"
      ],
      "properties": {
        "speech": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string"
        },
        "used_facts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "needs_fact": {
          "type": "boolean"
        },
        "next_sales_thread": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": [
        "source",
        "split",
        "quality",
        "tags"
      ],
      "properties": {
        "source": {
          "enum": [
            "human_gold",
            "synthetic_reviewed",
            "real_live_reviewed"
          ]
        },
        "split": {
          "enum": [
            "train",
            "validation",
            "test"
          ]
        },
        "quality": {
          "enum": [
            "gold",
            "silver",
            "rejected"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "voice_style": {
          "type": "string"
        },
        "reviewer_notes": {
          "type": "string"
        },
        "source_document": {
          "type": "string"
        },
        "source_timestamp": {
          "type": "string"
        },
        "observed_speech": {
          "type": "string"
        },
        "observed_comment": {
          "type": "string"
        },
        "duplicate_group": {
          "type": "string"
        },
        "evidence_quality": {
          "enum": [
            "direct",
            "mixed",
            "derived"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
